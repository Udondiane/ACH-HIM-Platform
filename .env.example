# ─────────────────────────────────────────────────────────────────────
# ACH HIM Platform · environment variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` before running `npm run dev` or `next build`.
# For production these are set in Vercel (or the ACH hosting provider) —
# never commit real values.

# Supabase  (required)
# ─────────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Service-role key.  Required for admin/seed paths.  While
# NEXT_PUBLIC_AUTH_DISABLED=true is set, HIM uses this key server-side
# so RLS is bypassed until real SSO is wired.  NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Auth bypass  (pre-production only)
# ─────────────────────────────────────────────────────────────────────
# When true, all requests are treated as an ACH-staff synthetic user.
# Set to false when SSO (Microsoft Entra ID) is wired; RLS then applies.
NEXT_PUBLIC_AUTH_DISABLED=true

# Azure OpenAI  (optional — powers AI scoring assist and voice transcription)
# ─────────────────────────────────────────────────────────────────────
# If unset, the AI scoring pipeline is silently skipped — assessments still
# work, just without the independent AI second opinion.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Cron secret  (required for scheduled jobs)
# ─────────────────────────────────────────────────────────────────────
# Shared secret between Vercel Cron (or Azure) and HIM's cron endpoints.
# Header: `Authorization: Bearer $CRON_SECRET` on the incoming request.
CRON_SECRET=generate-a-long-random-string
