# ── Azure Database for PostgreSQL Flexible Server ────────
# Get from: Azure Portal → PostgreSQL Flexible Server → Connection strings
DATABASE_URL=postgresql://him_app:REDACTED@ach-him.postgres.database.azure.com:5432/him?sslmode=require

# ── Microsoft Entra ID · workforce tenant (ACH staff + Microsoft partners) ──
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=

# App Registration → Overview
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
# App Registration → Certificates & secrets → New client secret
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Replace <TENANT_GUID> with ACH's tenant id
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_GUID>/v2.0

# Tenant GUID (needed for Microsoft Graph invitation calls)
AZURE_TENANT_ID=<TENANT_GUID>

# ── Microsoft Entra External ID · non-Microsoft partners (optional) ─────────
# Enable email-OTP sign-in for partners without work Microsoft accounts.
# Skip this block if all partners have Microsoft 365. When enabled, add
# NEXT_PUBLIC_EXTERNAL_ID_ENABLED=true so the sign-in page shows the button.
# AUTH_MICROSOFT_EXTERNAL_ID_ID=
# AUTH_MICROSOFT_EXTERNAL_ID_SECRET=
# AUTH_MICROSOFT_EXTERNAL_ID_ISSUER=https://<extid-tenant>.ciamlogin.com/<TENANT_GUID>/v2.0
# NEXT_PUBLIC_EXTERNAL_ID_ENABLED=true

# ── Azure Blob Storage (dev: connection string; prod: managed identity) ────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=achhim;AccountKey=REDACTED;EndpointSuffix=core.windows.net
# Or, in production with managed identity:
# AZURE_STORAGE_ACCOUNT_NAME=achhim

# ── Azure OpenAI (AI scoring + Whisper transcription) ────────
# Get from: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://ach-openai-uksouth.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
# Optional; defaults to 2024-08-01-preview
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Local dev fallback: if Azure OpenAI isn't configured, use public OpenAI.
# NEVER set this in production — Azure OpenAI keeps data in the ACH tenant.
# USE_DIRECT_OPENAI=true
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1

# ── One-time data migration (Supabase → Azure) ────────────
# Only needed by scripts/migrate-data.mjs and scripts/migrate-files.mjs.
# Do NOT leave populated in prod env after cutover.
# SUPABASE_DB_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# AZURE_DB_URL=$DATABASE_URL

# ── Local dev only — skip auth so pages render without a real Entra login ─
# NEVER set this to true in production.
AUTH_DISABLED=true

# ── Next.js public runtime ────────────────────────────────
NEXTAUTH_URL=http://localhost:3100
