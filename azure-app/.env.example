# ── Azure Database for PostgreSQL Flexible Server ────────
# Get from: Azure Portal → PostgreSQL Flexible Server → Connection strings
DATABASE_URL=postgresql://him_app:REDACTED@ach-him.postgres.database.azure.com:5432/him?sslmode=require

# ── Microsoft Entra ID (Azure AD) via NextAuth v5 ────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=

# App Registration → Overview
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
# App Registration → Certificates & secrets → New client secret
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Replace <TENANT_GUID> with ACH's tenant id
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_GUID>/v2.0

# ── Azure Blob Storage (dev: connection string; prod: managed identity) ────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=achhim;AccountKey=REDACTED;EndpointSuffix=core.windows.net
# Or, in production with managed identity:
# AZURE_STORAGE_ACCOUNT_NAME=achhim

# ── Local dev only — skip auth so pages render without a real Entra login ─
# NEVER set this to true in production.
AUTH_DISABLED=true

# ── Next.js public runtime ────────────────────────────────
NEXTAUTH_URL=http://localhost:3100
