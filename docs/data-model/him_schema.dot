    "project_capabilities" [fillcolor="#D9E7C7"];
    "project_data_providers" [fillcolor="#D9E7C7"];
    "project_training_programmes" [fillcolor="#D9E7C7"];
    "candidate_consent" [fillcolor="#D9E7C7"];
    "candidate_support" [fillcolor="#D9E7C7"];
  }

  subgraph cluster_1 {
    label = "Assessment engine";
    fontsize = 13;
    fontname = "Helvetica-Bold";
    style = filled;
    fillcolor = "#f9f9f9";
    color = "#bbbbbb";
    "assessments" [fillcolor="#C7E1E7"];
