    "indicators" [fillcolor="#E7C7DE"];
    "equivalence_applications" [fillcolor="#E7C7DE"];
    "equivalence_values" [fillcolor="#E7C7DE"];
  }

  subgraph cluster_3 {
    label = "Partners & placements";
    fontsize = 13;
