digraph HIM_schema {
  graph [rankdir=LR, splines=ortho, nodesep=0.30, ranksep=0.60, fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge [color="#555555", arrowhead=vee, arrowsize=0.7];

  subgraph cluster_0 {
    label = "People & Programme";
    fontsize = 13;
    fontname = "Helvetica-Bold";
    style = filled;
    fillcolor = "#f9f9f9";
    color = "#bbbbbb";
    "candidates" [fillcolor="#D9E7C7"];
    "cohorts" [fillcolor="#D9E7C7"];
    "cohort_candidates" [fillcolor="#D9E7C7"];
    "projects" [fillcolor="#D9E7C7"];
